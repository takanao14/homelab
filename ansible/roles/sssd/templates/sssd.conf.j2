[sssd]
config_file_version = 2
domains = {{ sssd_domain }}
services = nss, pam, ssh

[nss]
homedir_substring = /home

[pam]
# offline login is a convenience for short outages only
offline_credentials_expiration = {{ sssd_offline_credentials_expiration }}

[domain/{{ sssd_domain }}]
id_provider = ldap
auth_provider = ldap
chpass_provider = none
access_provider = ldap

ldap_uri = {{ sssd_ldap_uri }}
ldap_search_base = {{ sssd_ldap_search_base }}
ldap_tls_reqcert = demand
ldap_tls_cacert = {{ sssd_ldap_ca_cert_path }}

ldap_default_bind_dn = {{ sssd_ldap_bind_dn }}
ldap_default_authtok_type = password
ldap_default_authtok = {{ sssd_ldap_bind_password }}

# LLDAP schema; POSIX attributes are custom attributes populated by
# roles/lldap. The (uidNumber=*) and (gidNumber=*) filters hide the bind
# account and any group without a GID.
ldap_schema = rfc2307bis
ldap_user_search_base = ou=people,{{ sssd_ldap_search_base }}?subtree?(uidNumber=*)
ldap_user_object_class = posixAccount
ldap_user_name = uid
ldap_user_gecos = cn
ldap_user_uid_number = uidNumber
ldap_user_gid_number = gidNumber
ldap_user_home_directory = homeDirectory
ldap_user_shell = unixShell
ldap_user_ssh_public_key = sshPublicKey
ldap_user_member_of = memberOf

ldap_group_search_base = ou=groups,{{ sssd_ldap_search_base }}?subtree?(gidNumber=*)
ldap_group_object_class = groupOfUniqueNames
ldap_group_name = cn
ldap_group_gid_number = gidNumber
ldap_group_member = uniqueMember

# LLDAP has no disabled state; removing the group membership revokes login.
ldap_access_order = filter
ldap_access_filter = (memberOf=cn={{ sssd_allowed_login_group }},ou=groups,{{ sssd_ldap_search_base }})

fallback_homedir = {{ sssd_home_dir_template }}
default_shell = {{ sssd_default_shell }}
cache_credentials = true
enumerate = false

# Bound stale initgroups data used by sudo (SSSD default: 5400s).
entry_cache_timeout = {{ sssd_entry_cache_timeout }}
