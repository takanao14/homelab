#!/bin/sh
set -eu

metrics_output="{{ knot_resolver_metrics_path }}"
metrics_tmp="$(mktemp "${metrics_output}.tmp.XXXXXX")"

cleanup() {
  rm -f "${metrics_tmp}"
}
trap cleanup EXIT HUP INT TERM

/usr/bin/kresctl metrics --prometheus > "${metrics_tmp}"
chmod 0644 "${metrics_tmp}"
mv -f "${metrics_tmp}" "${metrics_output}"

trap - EXIT HUP INT TERM

