[Unit]
Description=Collect Knot Resolver metrics

[Timer]
OnBootSec=1min
OnUnitActiveSec={{ knot_resolver_metrics_interval }}
# Keep jitter and accuracy below the sub-minute collection interval.
RandomizedDelaySec=1s
AccuracySec=1s
Persistent=true
Unit=knot-resolver-metrics.service

[Install]
WantedBy=timers.target
