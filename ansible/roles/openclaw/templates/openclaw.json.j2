{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": {{ openclaw_listen_port }},
    "publicOrigin": "{{ openclaw_public_origin }}",
    "trustedProxies": ["{{ openclaw_caddy_address }}"],
    "auth": {
      "mode": "token",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:{{ openclaw_listen_port }}",
        "http://localhost:{{ openclaw_listen_port }}",
        "{{ openclaw_public_origin }}"
      ]
    }
  },
  "mcp": {
    "servers": {
{% for name, server in mcp_client_servers.items() %}
      "{{ name }}": {
        "transport": "streamable-http",
        "url": {{ server.url | to_json }},
        "headers": {
          "Authorization": "Bearer ${MCP_{{ name | upper }}_SERVER_TOKEN}"
        },
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000,
        "sslVerify": true,
        "toolFilter": { "include": {{ server.tools | to_json }} }
      }{{ ',' if not loop.last else '' }}
{% endfor %}
    }
  },
  "plugins": {
    "load": { "paths": ["/opt/openclaw-plugins/parallel-{{ openclaw_web_plugin_version }}"] },
    "entries": { "parallel": { "enabled": true } }
  },
  "tools": {
    "web": {
      "search": { "enabled": true, "provider": "parallel-free", "maxResults": 5 },
      "fetch": { "enabled": true, "maxChars": 12000, "timeoutSeconds": 30 }
    },
    "profile": "minimal",
    "alsoAllow": [
      "web_search",
      "web_fetch",
{% for name, server in mcp_client_servers.items() %}
{% for tool in server.tools %}
      "{{ name }}__{{ tool }}"{{ ',' if not (loop.last and name == (mcp_client_servers.keys() | list | last)) else '' }}
{% endfor %}
{% endfor %}
    ]
  },
  "agents": {
    "defaults": {
      "model": { "primary": "lemonade/{{ openclaw_model_id }}" }
    }
  },
  "models": {
    "providers": {
      "lemonade": {
        "baseUrl": "{{ openclaw_model_url }}",
        "apiKey": "sk-local",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "{{ openclaw_model_id }}",
            "name": "Gemma 4 12B MTP (Lemonade)",
            "contextWindow": {{ openclaw_model_context_window }},
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
