[Unit]
Description=OpenClaw Gateway
Wants=network-online.target
After=network-online.target
Requires=openclaw-firewall.service
After=openclaw-firewall.service

{% if openclaw_rootless_enabled %}
Requires=user@{{ openclaw_rootless_uid }}.service
After=user@{{ openclaw_rootless_uid }}.service
{% endif %}

[Service]
{% if openclaw_rootless_enabled %}
Delegate=yes
User={{ openclaw_rootless_user }}
Group={{ openclaw_rootless_user }}
Environment=HOME=/var/lib/{{ openclaw_rootless_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ openclaw_rootless_uid }}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ openclaw_rootless_uid }}/bus
{% endif %}
Type=simple
Restart=always
RestartSec=5s
TimeoutStopSec=345s
ExecStartPre=-/usr/bin/podman rm --force {{ openclaw_container_name }}
ExecStart=/usr/bin/podman run --rm --name {{ openclaw_container_name }} \
  --entrypoint=node \
  --hostname={{ openclaw_container_name }} \
{% if openclaw_rootless_enabled %}
  --userns=keep-id:uid=1000,gid=1000 \
  --user=1000:1000 \
{% endif %}
  --pull=never \
  --publish=127.0.0.1:{{ openclaw_listen_port }}:{{ openclaw_listen_port }} \
  --publish={{ ansible_host }}:{{ openclaw_listen_port }}:{{ openclaw_listen_port }} \
  --env-file={{ openclaw_config_dir }}/openclaw.env \
  --env-file={{ openclaw_config_dir }}/mcp.env \
  --env=HOME=/home/node \
  --env=OPENCLAW_HOME=/home/node \
  --env=OPENCLAW_STATE_DIR=/home/node/.openclaw \
  --env=OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json \
  --volume={{ openclaw_state_dir }}:/home/node/.openclaw:Z \
  --volume={{ openclaw_plugin_dir }}:/opt/openclaw-plugins:ro \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  {{ openclaw_image }} dist/index.js gateway --bind lan
ExecStop=/usr/bin/podman stop --time 330 {{ openclaw_container_name }}

[Install]
WantedBy=multi-user.target
