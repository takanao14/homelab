# Ansible managed
modules:
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4

  # Service-port liveness for hosts already covered by the icmp module.
  tcp_connect:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4

{% if blackbox_exporter_ldaps_enabled | bool %}
  ldaps:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      tls_config:
        ca_file: {{ blackbox_exporter_ldaps_ca_path }}
        server_name: {{ identity_ldap_host }}

{% endif %}
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]

  dns_external:
    prober: dns
    timeout: 5s
    dns:
      query_name: "google.com"
      query_type: A
      valid_rcodes:
        - NOERROR

  dns_internal:
    prober: dns
    timeout: 5s
    dns:
      query_name: "{{ blackbox_exporter_dns_internal_query }}"
      query_type: A
      valid_rcodes:
        - NOERROR

  dns_authoritative_udp:
    prober: dns
    timeout: 5s
    dns:
      transport_protocol: udp
      preferred_ip_protocol: ip4
      query_name: "."
      query_type: NS
      recursion_desired: false
      valid_rcodes:
        - NOERROR

  dns_authoritative_tcp:
    prober: dns
    timeout: 5s
    dns:
      transport_protocol: tcp
      preferred_ip_protocol: ip4
      query_name: "."
      query_type: NS
      recursion_desired: false
      valid_rcodes:
        - NOERROR
