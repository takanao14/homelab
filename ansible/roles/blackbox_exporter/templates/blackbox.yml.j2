# Ansible managed
modules:
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4

  # Service-port liveness for hosts already covered by the icmp module.
  tcp_connect:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4

  dns_external:
    prober: dns
    timeout: 5s
    dns:
      query_name: "google.com"
      query_type: A
      valid_rcodes:
        - NOERROR

  dns_internal:
    prober: dns
    timeout: 5s
    dns:
      query_name: "{{ blackbox_exporter_dns_internal_query }}"
      query_type: A
      valid_rcodes:
        - NOERROR

  dns_authoritative_udp:
    prober: dns
    timeout: 5s
    dns:
      transport_protocol: udp
      preferred_ip_protocol: ip4
      query_name: "."
      query_type: NS
      recursion_desired: false
      valid_rcodes:
        - NOERROR

  dns_authoritative_tcp:
    prober: dns
    timeout: 5s
    dns:
      transport_protocol: tcp
      preferred_ip_protocol: ip4
      query_name: "."
      query_type: NS
      recursion_desired: false
      valid_rcodes:
        - NOERROR
