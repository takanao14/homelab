# 127.0.0.1 is what the role's own readiness check and any host-local probe use.
ALLOWED_HOSTS={{ netbox_domain }} localhost 127.0.0.1
CSRF_TRUSTED_ORIGINS=https://{{ netbox_domain }}
# Sent only on requests Caddy marks as HTTPS through X-Forwarded-Proto.
SECURE_HSTS_SECONDS=31536000
# Copilot loads third-party JavaScript into authenticated sessions.
COPILOT_ENABLED=False

DB_HOST={{ netbox_pg_container }}
DB_NAME={{ netbox_db_name }}
DB_USER={{ netbox_db_user }}
DB_PASSWORD={{ netbox_db_password }}

REDIS_HOST={{ netbox_redis_container }}
REDIS_DATABASE=0
REDIS_CACHE_HOST={{ netbox_redis_cache_container }}
REDIS_CACHE_DATABASE=1

SECRET_KEY={{ netbox_secret_key }}
API_TOKEN_PEPPER_1={{ netbox_api_token_pepper }}

SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_password }}
