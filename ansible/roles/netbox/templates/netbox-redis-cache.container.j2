[Unit]
Description=NetBox caching Valkey
After=network-online.target
Wants=network-online.target

[Container]
ContainerName={{ netbox_redis_cache_container }}
Image={{ netbox_redis_image }}
Network={{ netbox_network }}.network
HealthCmd=valkey-cli ping
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=10s
HealthTimeout=3s

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
