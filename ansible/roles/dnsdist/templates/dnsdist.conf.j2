-- backend

-- internal backends
{% for backend in dnsdist_internal_backends %}
newServer({
    address="{{ backend.address }}",
    pool="{{ backend.pool }}",
    name="{{ backend.name | default(backend.address) }}",
    checkName="{{ backend.checkName }}",
    checkType="{{ backend.checkType }}",
})
{% endfor %}

-- recursive (internet) backends
{% for backend in dnsdist_default_backends %}
newServer({
    address="{{ backend.address }}",
    pool="{{ backend.pool }}",
    name="{{ backend.name | default(backend.address) }}",
    checkName="{{ backend.checkName }}",
    checkType="{{ backend.checkType }}",
})
{% endfor %}

-- Packet Cache for recursive (internet) queries
-- Pool "" is the default pool containing external resolvers
local pc = newPacketCache({{ dnsdist_packet_cache_size }}, {
    maxTTL={{ dnsdist_packet_cache_max_ttl }},
    temporaryFailureTTL=60,
    staleTTL=60
})
getPool(""):setCache(pc)

-- internal domain routing
local internal_domains = newSuffixMatchNode()
{% for domain in dnsdist_internal_domains %}
internal_domains:add("{{ domain }}")
{% endfor %}
addAction(SuffixMatchNodeRule(internal_domains), SetNoRecurseAction())
addAction(SuffixMatchNodeRule(internal_domains), PoolAction("internal"))

-- locally served reverse zones (RFC 6303)
-- Answered here instead of being forwarded to the public resolvers in the
-- default pool, which can never hold RFC1918 PTR data. RCodeAction is terminal,
-- so these never reach a backend and never leave the LAN. Clients see the same
-- NXDOMAIN the public resolvers were already returning. Listed in
-- dnsdist_local_reverse_zones; must stay disjoint from dnsdist_internal_domains.
local local_reverse = newSuffixMatchNode()
{% for zone in dnsdist_local_reverse_zones %}
local_reverse:add("{{ zone }}")
{% endfor %}
addAction(SuffixMatchNodeRule(local_reverse), RCodeAction(DNSRCode.NXDOMAIN))

-- default routing

-- Frontend
setLocal("{{ dnsdist_server_addr }}:53")

-- logging
setRingBuffersSize(10000)

-- dnstap
local dnstapLogger = newFrameStreamUnixLogger("/run/dnstap-dnsdist.sock")
addAction(AllRule(), DnstapLogAction("dnsdist", dnstapLogger))
addResponseAction(AllRule(), DnstapLogResponseAction("dnsdist", dnstapLogger))

-- console setting
local consoleKey="{{ dnsdist_console_key }}"
local consoleACL="{{ dnsdist_console_acl }}"

-- Bound to loopback rather than 0.0.0.0: setConsoleACL already rejects every
-- source outside dnsdist_console_acl (127.0.0.1/32), so a wildcard bind only
-- adds a reachable port with nothing behind it. Widening the ACL to a remote
-- host means widening this bind as well.
controlSocket("127.0.0.1:5199")
setKey(consoleKey)
setConsoleACL(consoleACL)

-- api setting
local webPass="{{ dnsdist_web_password }}"
local webApiKey="{{ dnsdist_web_api_key }}"
local mgmtACL="{{ dnsdist_mgmt_acl }}"

webserver("{{ dnsdist_server_addr }}:8083")
-- statsRequireAuthentication=false is load-bearing, not an oversight: the
-- ScrapeConfig in k8s/monitoring/charts/dnsdist scrapes
-- http://<recursor-ip>:8083/metrics with no authorization stanza, so requiring
-- auth here would silently blank the dnsdist dashboards. dashboardRequiresAuthentication
-- is a separate flag covering only the HTML UI at /, kept off so the dashboard
-- stays browsable on the LAN. Reach for both is bounded by mgmtACL; the
-- password and apiKey above still guard the /api endpoints.
setWebserverConfig({
    password=webPass,
    apiKey=webApiKey,
    acl=mgmtACL,
    statsRequireAuthentication=false,
    dashboardRequiresAuthentication=false
})
