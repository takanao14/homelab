log:
  level: info

runner:
  file: {{ forgejo_runner_home }}/.runner
  capacity: 1
  timeout: 3h
  fetch_interval: 2s

cache:
  enabled: false

container:
  network: {{ forgejo_runner_container_network | to_json }}
  privileged: false
  valid_volumes: []
  docker_host: {{ ('automount' if forgejo_runner_mount_docker_socket else '-') | to_json }}
