version: 1
metadata:
  name: homelab gpu-switch
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_proxy.proxyprovider
    id: gpu-switch-prd-provider
    identifiers:
      name: gpu-switch-prd
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: https://gpu-switch.prd.butaco.net
      basic_auth_enabled: false
      access_token_validity: hours=8

  - model: authentik_core.application
    id: gpu-switch-prd-application
    identifiers:
      slug: gpu-switch-prd
    attrs:
      name: GPU Switch (prd)
      provider: !KeyOf gpu-switch-prd-provider
      policy_engine_mode: any
      meta_description: Assigns the single prd AMD GPU by scaling labelled
        Deployments. Scoped RBAC, not cluster-admin (ADR-0027).

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf gpu-switch-prd-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.platform_admins }}]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf gpu-switch-prd-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.gpu_users }}]]
      order: 1
    attrs:
      enabled: true
