{#
  Templated so the LDAP service contract has one definition: `identity_*` in
  group_vars/all.yaml is what roles/sssd also reads.
#}
version: 1
metadata:
  name: homelab LDAP provider
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  # Use the role-generated service-name certificate; SSSD trusts it directly.
  - model: authentik_providers_ldap.ldapprovider
    id: ldap-provider
    identifiers:
      name: homelab-ldap
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      base_dn: {{ identity_ldap_base_dn }}
      certificate: !Find [authentik_crypto.certificatekeypair, [name, {{ authentik_ldap_cert_name }}]]
      tls_server_name: {{ identity_ldap_host }}
      # See decision 14: IDs start at 10000 to avoid existing LDAP and local accounts.
      uid_start_number: 10000
      gid_start_number: 10000
      bind_mode: direct
      search_mode: cached
      mfa_support: false

  # SSSD lookup-only bind account; API grants search RBAC. Define before !KeyOf users.
  - model: authentik_rbac.role
    id: ldap-search-role
    identifiers:
      name: ldap-search

  - model: authentik_core.group
    identifiers:
      name: {{ authentik_ldap_service_group }}
    attrs:
      is_superuser: false
      roles:
        - !Find [authentik_rbac.role, [name, ldap-search]]

  - model: authentik_core.user
    identifiers:
      username: {{ identity_ldap_bind_user }}
    attrs:
      name: LDAP Search Service Account
      type: service_account
      is_active: true
      path: service-accounts
      groups:
        - !Find [authentik_core.group, [name, {{ authentik_ldap_service_group }}]]
      password: !Env LDAP_BIND_PASSWORD

  - model: authentik_core.application
    id: ldap-application
    identifiers:
      slug: ldap
    attrs:
      name: LDAP
      provider: !KeyOf ldap-provider
      policy_engine_mode: any

  # Allow {{ authentik_groups.linux_users }} or the SSSD lookup service; sudo admins also need login membership.
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf ldap-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.linux_users }}]]
    attrs:
      order: 0
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf ldap-application
      group: !Find [authentik_core.group, [name, {{ authentik_ldap_service_group }}]]
    attrs:
      order: 1
      enabled: true

  - model: authentik_outposts.outpost
    identifiers:
      name: {{ authentik_ldap_outpost_name }}
    attrs:
      type: ldap
      providers:
        - !KeyOf ldap-provider
      # Standalone Podman Quadlet outpost; no Authentik service connection.
      config: {}
