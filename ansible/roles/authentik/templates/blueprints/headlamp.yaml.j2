version: 1
metadata:
  name: homelab headlamp
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_proxy.proxyprovider
    id: headlamp-prd-provider
    identifiers:
      name: headlamp-prd
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: https://headlamp.prd.butaco.net
      basic_auth_enabled: false
      access_token_validity: hours=8

  # Sandbox remains HTTP-only; its session cookie lacks Secure (ADR-0010).
  - model: authentik_providers_proxy.proxyprovider
    id: headlamp-sandbox-provider
    identifiers:
      name: headlamp-sandbox
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: http://headlamp.sandbox.butaco.net
      basic_auth_enabled: false
      access_token_validity: hours=8

  - model: authentik_core.application
    id: headlamp-prd-application
    identifiers:
      slug: headlamp-prd
    attrs:
      name: Headlamp (prd)
      provider: !KeyOf headlamp-prd-provider
      policy_engine_mode: any
      meta_description: prd Kubernetes dashboard. Everyone admitted here shares
        the same cluster-admin ServiceAccount inside Headlamp.

  - model: authentik_core.application
    id: headlamp-sandbox-application
    identifiers:
      slug: headlamp-sandbox
    attrs:
      name: Headlamp (sandbox)
      provider: !KeyOf headlamp-sandbox-provider
      policy_engine_mode: any
      meta_description: sandbox Kubernetes dashboard. Everyone admitted here
        shares the same cluster-admin ServiceAccount inside Headlamp.

  # Headlamp uses cluster-admin, so admit only groups trusted at that level.
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf headlamp-prd-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.platform_admins }}]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf headlamp-prd-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.k8s_prd_admins }}]]
      order: 1
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf headlamp-sandbox-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.platform_admins }}]]
      order: 0
    attrs:
      enabled: true

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf headlamp-sandbox-application
      group: !Find [authentik_core.group, [name, {{ authentik_groups.k8s_sandbox_users }}]]
      order: 1
    attrs:
      enabled: true
