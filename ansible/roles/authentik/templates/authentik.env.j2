# Managed by Ansible (authentik role). Do not edit manually.
# Shared across the postgresql/server/worker Quadlet units; each container
# only reads the variable names it recognizes.
POSTGRES_PASSWORD={{ authentik_pg_pass }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ authentik_pg_pass }}
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
# Only applied while no admin user exists yet (see role README).
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
# Read by files/blueprints/test-users.yaml via !Env for the disposable
# stage-6 SSSD test user's password.
TEST_USER_PASSWORD={{ authentik_test_user_password }}
# Read by files/blueprints/ldap.yaml via !Env for the SSSD lookup service
# account (ldapbind, group lab-ldap-service).
LDAP_BIND_PASSWORD={{ authentik_ldap_bind_password }}
# Initial passwords for the accounts in the SOPS-managed `authentik_users`
# list, read by the templated users.yaml blueprint via !Env. Kept here rather
# than rendered into the blueprint because this file is 0600 and the blueprints
# directory is 0644. The variable name must match the one users.yaml.j2 builds.
{% for user in authentik_users %}
AUTHENTIK_USER_PASSWORD_{{ user.username | upper | regex_replace('[^A-Z0-9]', '_') }}={{ user.password }}
{% endfor %}
