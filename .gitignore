.idea
.vscode
# macOS Finder metadata, created in any directory that gets browsed.
.DS_Store
# Local tfstate snapshots (Phase 0 backup target if pointed inside the repo).
# tfstate may contain secrets and must never be committed.
**/*.tfstate
**/*.tfstate.backup
*-tfstate-backups/
tf/.state-backups/
**/charts/*.tgz
**/Chart.lock
ansible/collections/
# Generated k0sctl configs (create_cluster.sh mktemp leftovers / manual
# `config` output). Regenerated from env/*.sh; contain host addresses only,
# but must not be committed as they would drift from the generator.
k0s/k0sctl-*
# Symlinks into separate private repos (homelab-plans / homelab-md). Each has
# its own git history and is committed there, not here. They may be absent on
# a fresh clone, which is fine.
docs/plans
docs/md
