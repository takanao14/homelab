{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "network-overview"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "current-napt-entries": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Current NAPT Entries",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "naptCacheEntries{instance=\"bgw1\"}",
                        "legendFormat": "{{ifDescr}} {{ifAlias}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "interface-discards": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Interface Discards",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ifInDiscards{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"}[$__rate_interval]) and on(instance, ifIndex) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1)",
                        "legendFormat": "{{instance}} {{ifDescr}} In"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ifOutDiscards{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"}[$__rate_interval]) and on(instance, ifIndex) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1)",
                        "legendFormat": "{{instance}} {{ifDescr}} Out"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "2m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "pps",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "interface-errors": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Interface Errors",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ifInErrors{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"}[$__rate_interval]) and on(instance, ifIndex) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1)",
                        "legendFormat": "{{instance}} {{ifDescr}} In"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ifOutErrors{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"}[$__rate_interval]) and on(instance, ifIndex) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1)",
                        "legendFormat": "{{instance}} {{ifDescr}} Out"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "2m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "pps",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "interfaces-down": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Interfaces Down",
          "description": "Ports that are enabled but have no link. Ports shut down on purpose are excluded and counted separately, so anything here is a fault.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count by (instance) (ifOperStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} != 1 and on(instance, ifIndex) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1)) or count by (instance) (ifOperStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"}) * 0",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "interfaces-shutdown": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Interfaces Shutdown",
          "description": "Ports administratively disabled (ifAdminStatus=down). Not a fault, but these are excluded from Interfaces Up and Down, so the count is here to make the exclusion visible.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count by (instance) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 2) or count by (instance) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"}) * 0",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "interfaces-up": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Interfaces Up",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count by (instance) (ifOperStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1 and on(instance, ifIndex) (ifAdminStatus{ifDescr=~\"GigaEthernet[0-9]+|GigabitEthernet[0-9]+\", instance=~\"$instance\"} == 1))",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ipv4-forwarding-diagnostics": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "IPv4 Forwarding Diagnostics",
          "description": "Device-wide MIB-II counters. Compare failures with sub-interface errors; these counters do not identify the affected interface, ACL, or destination.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ipInDiscards{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "IPv4 input discards"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ipOutDiscards{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "IPv4 output discards"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ipOutNoRoutes{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "IPv4 no route"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ipFragFails{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "IPv4 fragmentation failures"
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ipFragCreates{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "IPv4 fragments created"
                      }
                    },
                    "refId": "E",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(ipReasmFails{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "IPv4 reassembly failures"
                      }
                    },
                    "refId": "F",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(icmpOutDestUnreachs{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "ICMP destination unreachable"
                      }
                    },
                    "refId": "G",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(udpInErrors{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "UDP input errors"
                      }
                    },
                    "refId": "H",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(udpNoPorts{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "UDP no port"
                      }
                    },
                    "refId": "I",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "2m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "pps",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "napt-cache-activity": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "NAPT Cache Activity",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(naptCacheCreates{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "{{ifDescr}} creates"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "rate(naptCacheOverflows{instance=\"bgw1\"}[$__rate_interval])",
                        "legendFormat": "{{ifDescr}} overflows"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "2m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "napt-utilization": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "NAPT Utilization",
          "description": "Current entries divided by the IX2106 default 65,535-entry capacity. Update the chart value if the router config overrides it.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "naptCacheEntries{instance=\"bgw1\"} / 65535",
                        "legendFormat": "{{ifDescr}} {{ifAlias}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "min": 0,
                  "max": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "peak-napt-entries": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Peak NAPT Entries",
