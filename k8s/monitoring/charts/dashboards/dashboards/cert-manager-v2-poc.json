                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Ready"
                    },
                    "properties": [
                      {
                        "id": "decimals",
                        "value": 0
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "red",
                              "value": null
                            },
                            {
                              "color": "green",
                              "value": 1
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.displayMode",
                        "value": "color-background"
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "options": {
                              "0": {
                                "index": 0,
                                "text": "Not Ready"
                              },
                              "1": {
                                "index": 1,
                                "text": "Ready"
                              }
                            },
                            "type": "value"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
