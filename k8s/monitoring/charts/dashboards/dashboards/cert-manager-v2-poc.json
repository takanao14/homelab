{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "cert-manager-v2-poc"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Days Until Expiry",
          "description": "Certificate expiry countdown. A jump upward indicates a successful renewal; below zero the certificate has already expired.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "(max by (cluster, exported_namespace, name) (certmanager_certificate_expiration_timestamp_seconds{cluster=~\"$cluster\"}) - time()) / 86400",
                        "legendFormat": "{{cluster}} {{exported_namespace}}/{{name}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "d",
                  "custom": {
                    "axisSoftMin": 0
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Scrape Target",
          "description": "Whether Prometheus can reach the cert-manager metrics endpoint. No data means the cert-manager ArgoCD application is not present in this cluster.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "min by (cluster) (up{job=\"cert-manager\",cluster=~\"$cluster\"}) or (0 * max by (cluster) (argocd_app_info{cluster=~\"$cluster\",name=\"cert-manager\"}))",
                        "instant": true,
                        "legendFormat": "Target",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "none",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "DOWN",
                          "color": "red"
                        },
                        "1": {
                          "text": "UP",
                          "color": "green"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Certs Not Ready",
          "description": "Certificates where the Ready condition is not True.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count(certmanager_certificate_ready_status{cluster=~\"$cluster\",condition=\"True\"} != 1) or vector(0)",
                        "legendFormat": "Not Ready"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "ClusterIssuers Not Ready",
          "description": "ClusterIssuers where the Ready condition is not True.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count(certmanager_clusterissuer_ready_status{cluster=~\"$cluster\",condition=\"True\"} != 1) or vector(0)",
                        "legendFormat": "Not Ready"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Sync Errors (1h)",
          "description": "cert-manager controller reconciliation errors in the last hour.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "ceil(sum(increase(certmanager_controller_sync_error_count{cluster=~\"$cluster\"}[1h]))) or vector(0)",
                        "legendFormat": "Errors"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "ACME Errors",
          "description": "Non-2xx responses from the ACME endpoint over the dashboard time range, including Let's Encrypt rate limits. Nonzero means issuance or renewal is being rejected, well before the expiry countdown reflects it.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "ceil(sum(increase(certmanager_http_acme_client_request_count{cluster=~\"$cluster\",status=~\"4..|5..\"}[$__range]))) or vector(0)",
                        "legendFormat": "Errors"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Certificate Status",
          "description": "Expiry, renewal schedule, and ready state for each certificate. Days Until Renewal shows when cert-manager will begin renewal attempts; negative means renewal is already in progress.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sort((certmanager_certificate_expiration_timestamp_seconds{cluster=~\"$cluster\"} - time()) / 86400)",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sort((certmanager_certificate_renewal_timestamp_seconds{cluster=~\"$cluster\"} - time()) / 86400)",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "certmanager_certificate_ready_status{cluster=~\"$cluster\",condition=\"True\"}",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "condition": true,
                        "container": true,
                        "endpoint": true,
                        "instance": true,
                        "issuer_kind": true,
                        "namespace": true,
                        "pod": true,
                        "prometheus": true,
                        "prometheus_replica": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value #A": 5,
                        "Value #B": 6,
                        "Value #C": 4,
                        "cluster": 0,
                        "exported_namespace": 1,
                        "issuer_name": 3,
                        "name": 2
                      },
                      "renameByName": {
                        "Value #A": "Days Until Expiry",
                        "Value #B": "Days Until Renewal",
                        "Value #C": "Ready",
                        "exported_namespace": "Namespace",
                        "issuer_name": "Issuer",
                        "name": "Certificate"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": null,
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Days Until Expiry"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "d"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "red",
                              "value": null
                            },
                            {
                              "color": "orange",
                              "value": 7
                            },
                            {
                              "color": "green",
                              "value": 21
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.displayMode",
                        "value": "color-background"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Days Until Renewal"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "d"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Ready"
                    },
                    "properties": [
                      {
                        "id": "decimals",
                        "value": 0
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "red",
                              "value": null
                            },
                            {
                              "color": "green",
                              "value": 1
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.displayMode",
                        "value": "color-background"
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "options": {
                              "0": {
                                "index": 0,
                                "text": "Not Ready"
                              },
                              "1": {
                                "index": 1,
                                "text": "Ready"
                              }
                            },
                            "type": "value"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "ClusterIssuer Status",
