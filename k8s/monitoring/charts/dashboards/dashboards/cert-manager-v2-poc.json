                        "pod": true,
                        "prometheus": true,
                        "prometheus_replica": true,
                        "service": true
                      },
                      "indexByName": {
                        "Value": 2,
                        "cluster": 0,
                        "name": 1
                      },
                      "renameByName": {
                        "Value": "Ready",
                        "name": "Issuer"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
