{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "argocd-overview"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "app-reconcile-latency": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "App Reconcile Latency",
          "description": "Application reconciliation duration percentiles in the application-controller.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.99, sum by (cluster, le) (rate(argocd_app_reconcile_bucket{cluster=~\"$cluster\"}[$__rate_interval])))",
                        "legendFormat": "{{cluster}} p99"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.50, sum by (cluster, le) (rate(argocd_app_reconcile_bucket{cluster=~\"$cluster\"}[$__rate_interval])))",
                        "legendFormat": "{{cluster}} p50"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "apps-by-health-status": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Apps by Health Status",
          "description": "Application count per health status.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count by (cluster, health_status) (argocd_app_info{cluster=~\"$cluster\"})",
                        "legendFormat": "{{cluster}} {{health_status}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* Healthy"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* (Degraded|Missing)"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* Progressing"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "yellow",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "apps-by-sync-status": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Apps by Sync Status",
          "description": "Application count per sync status.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count by (cluster, sync_status) (argocd_app_info{cluster=~\"$cluster\"})",
                        "legendFormat": "{{cluster}} {{sync_status}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "fillOpacity": 10,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* Synced"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* OutOfSync"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "orange",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "apps-needing-attention": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Apps Needing Attention",
          "description": "Applications that are not Healthy or not Synced. Empty is good.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "argocd_app_info{cluster=~\"$cluster\",health_status!=\"Healthy\"} or argocd_app_info{cluster=~\"$cluster\",sync_status!=\"Synced\"}",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "includeByName": {
                        "cluster": true,
                        "dest_namespace": true,
                        "health_status": true,
                        "name": true,
                        "project": true,
                        "sync_status": true
                      },
                      "indexByName": {
                        "cluster": 0,
                        "dest_namespace": 3,
                        "health_status": 4,
                        "name": 1,
                        "project": 2,
                        "sync_status": 5
                      },
                      "renameByName": {
                        "dest_namespace": "Namespace",
                        "health_status": "Health",
                        "name": "Application",
                        "project": "Project",
                        "sync_status": "Sync"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": null,
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "inspect": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "apps-not-healthy": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Apps Not Healthy",
          "description": "Applications whose health status is not Healthy.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count(argocd_app_info{cluster=~\"$cluster\",health_status!=\"Healthy\"}) or vector(0)",
                        "legendFormat": "Not Healthy"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "apps-outofsync": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Apps OutOfSync",
          "description": "Applications whose sync status is not Synced.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count(argocd_app_info{cluster=~\"$cluster\",sync_status!=\"Synced\"}) or vector(0)",
                        "legendFormat": "OutOfSync"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "cluster-connections-down": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Cluster Connections Down",
          "description": "Destination clusters the application-controller cannot reach.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "count(argocd_cluster_connection_status{cluster=~\"$cluster\"} == 0) or vector(0)",
                        "legendFormat": "Down"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "git-ls-remote-failures-1h": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Git ls-remote Failures (1h)",
          "description": "Failed git ls-remote calls from the repo-server in the last hour. Nonzero means ArgoCD could not reach the Git remote, so every application stops seeing new commits.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "ceil(sum(increase(argocd_git_lsremote_fail_total{cluster=~\"$cluster\"}[1h]))) or vector(0)",
                        "legendFormat": "Failures"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "git-request-duration-p95": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Git Request Duration p95",
          "description": "95th percentile git request duration, by request type. Slow fetches point at repo size or network issues. Git requests are sparse, so samples are drawn as points; a gap means no request occurred, not a failure.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.95, sum by (cluster, request_type, le) (rate(argocd_git_request_duration_seconds_bucket{cluster=~\"$cluster\"}[$__rate_interval])))",
                        "legendFormat": "{{cluster}} {{request_type}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "15m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "s",
                  "custom": {
                    "showPoints": "always",
                    "pointSize": 6
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "git-requests": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Git Requests",
          "description": "Git requests from the repo-server per interval, by request type. ls-remote is the polling loop and should hold a steady height; a drop to zero means polling stopped.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "round(sum by (cluster) (increase(argocd_git_request_total{cluster=~\"$cluster\",request_type=\"ls-remote\"}[$__interval])))",
                        "legendFormat": "{{cluster}} ls-remote"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "round(sum by (cluster) (increase(argocd_git_request_total{cluster=~\"$cluster\",request_type=\"fetch\"}[$__interval])))",
                        "legendFormat": "{{cluster}} fetch"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "10m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "gradientMode": "hue",
                    "fillOpacity": 100,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "sync-activity": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Sync Activity",
          "description": "Completed sync operations per interval, by result phase. Dry-run syncs are excluded.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "round(sum by (cluster) (increase(argocd_app_sync_total{cluster=~\"$cluster\",dry_run=\"false\",phase=\"Succeeded\"}[$__interval])))",
                        "legendFormat": "{{cluster}} Succeeded"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "round(sum by (cluster, phase) (increase(argocd_app_sync_total{cluster=~\"$cluster\",dry_run=\"false\",phase=~\"Error|Failed\"}[$__interval])))",
                        "legendFormat": "{{cluster}} {{phase}}"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "10m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "drawStyle": "bars",
                    "gradientMode": "hue",
                    "fillOpacity": 100,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* (Error|Failed)"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* Succeeded"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "sync-failures-1h": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Sync Failures (1h)",
          "description": "Sync operations that ended in Error or Failed in the last hour.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
