      "lease-events-by-type": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Lease Events by Type",
          "description": "Transition events only; a poll that changes nothing stays silent.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$loki_datasource"
                      },
                      "spec": {
                        "expr": "sum by (event) (count_over_time({unit=\"dhcp-lease-observer.service\"} | json | __error__=\"\" | event =~ \"lease_.*\" | ip =~ \"$ip\" [$__auto]))",
                        "legendFormat": "{{event}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "1m"
