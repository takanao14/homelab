                      "spec": {
                        "expr": "{unit=\"dhcp-lease-observer.service\"} | json | __error__=\"\" | ip =~ \"$ip\" | device_id =~ \"$device\" | line_format \"{{.event}} {{.ip}} {{.device_id}} {{.state}}\"",
