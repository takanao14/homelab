      "top-nxdomain-time-range": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Top NXDOMAIN (Time Range)",
          "description": "Every NXDOMAIN name, unfiltered, over the full dashboard time range. The composition by category is in NXDOMAIN by Category above; this panel deliberately hides nothing.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sort_desc(topk(10, sum by (dns_qname) (count_over_time({job=\"dns\", identity=~\"$host\"} | json | __error__=\"\" | dnstap_operation=\"CLIENT_RESPONSE\" | dns_rcode=\"NXDOMAIN\" | dns_qname != \"\" [$__range]))))",
                        "legendFormat": "{{dns_qname}}",
                        "range": false,
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "valueMode": "color",
                "namePlacement": "auto",
                "showUnfilled": true,
                "sizing": "auto",
                "minVizWidth": 8,
                "minVizHeight": 16,
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": false,
                  "calcs": []
                },
                "reduceOptions": {
                  "values": true,
                  "limit": 10,
                  "calcs": []
                },
                "maxVizHeight": 300,
                "orientation": "horizontal"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
