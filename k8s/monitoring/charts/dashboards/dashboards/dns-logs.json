                        "expr": "sum by (dns_qtype) (rate({job=\"dns\", identity=~\"$host\"} | json | __error__=\"\" | dnstap_operation=\"CLIENT_QUERY\"[$__auto])) or sum by (dns_qtype) (count_over_time({job=\"dns\", identity=~\"$host\"} | json | __error__=\"\" | dnstap_operation=\"CLIENT_QUERY\"[$__range])) * 0",
                        "legendFormat": "{{dns_qtype}}"
                      }
