{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "envoy-gateway-overview"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "4xx-5xx-by-httproute": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "4xx / 5xx by HTTPRoute",
          "description": "Upstream error responses per second per HTTPRoute.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster, route) (label_replace(sum by (cluster, envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\",envoy_response_code_class=\"4\"}[$__rate_interval])), \"route\", \"$1/$2\", \"envoy_cluster_name\", \"httproute/([^/]+)/([^/]+)/.*\")) or sum by (cluster, route) (label_replace(sum by (cluster, envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval])), \"route\", \"$1/$2\", \"envoy_cluster_name\", \"httproute/([^/]+)/([^/]+)/.*\")) * 0",
                        "legendFormat": "{{cluster}} {{route}} 4xx"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster, route) (label_replace(sum by (cluster, envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\",envoy_response_code_class=\"5\"}[$__rate_interval])), \"route\", \"$1/$2\", \"envoy_cluster_name\", \"httproute/([^/]+)/([^/]+)/.*\")) or sum by (cluster, route) (label_replace(sum by (cluster, envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval])), \"route\", \"$1/$2\", \"envoy_cluster_name\", \"httproute/([^/]+)/([^/]+)/.*\")) * 0",
                        "legendFormat": "{{cluster}} {{route}} 5xx"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {}
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* 5xx"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "controller-reconcile-errors": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Controller Reconcile Errors",
          "description": "controller-runtime reconcile errors per second in the envoy-gateway controller.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster) (rate(controller_runtime_reconcile_errors_total{job=\"envoy-gateway\",cluster=~\"$cluster\"}[$__rate_interval]))",
                        "legendFormat": "{{cluster}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "downstream-active-connections": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Downstream Active Connections",
          "description": "Active downstream connections per traffic listener.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster, envoy_http_conn_manager_prefix) (envoy_http_downstream_cx_active{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_http_conn_manager_prefix!~\"admin|eg-.*\"})",
                        "legendFormat": "{{cluster}} {{envoy_http_conn_manager_prefix}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "downstream-response-codes": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Downstream Response Codes",
          "description": "Responses per second by status code class, across traffic listeners.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (envoy_response_code_class) (rate(envoy_http_downstream_rq_xx{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_http_conn_manager_prefix!~\"admin|eg-.*\"}[$__rate_interval]))",
                        "legendFormat": "{{envoy_response_code_class}}xx"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {
                    "fillOpacity": 10,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "2xx"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "3xx"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "4xx"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "orange",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "5xx"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "gateway-api-status-updates": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "Gateway API Status Updates",
          "description": "Status updates actually written by the envoy-gateway controller, per resource kind. Evaluations that concluded nothing needed writing (status=\"no_action\") are excluded.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster, kind) (rate(status_update_total{job=\"envoy-gateway\",cluster=~\"$cluster\",status=\"success\"}[$__rate_interval]))",
                        "legendFormat": "{{cluster}} {{kind}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ops",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "listener-rps": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Listener RPS",
          "description": "Total downstream requests per second across traffic listeners.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(rate(envoy_http_downstream_rq_total{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_http_conn_manager_prefix!~\"admin|eg-.*\"}[$__rate_interval]))",
                        "legendFormat": "RPS"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "decimals": 2,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "request-rate-by-httproute": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Request Rate by HTTPRoute",
          "description": "Upstream requests per second per HTTPRoute.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster, route) (label_replace(sum by (cluster, envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval])), \"route\", \"$1/$2\", \"envoy_cluster_name\", \"httproute/([^/]+)/([^/]+)/.*\"))",
                        "legendFormat": "{{cluster}} {{route}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "request-rate-by-listener": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Request Rate by Listener",
          "description": "Downstream requests per second per traffic listener.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (cluster, envoy_http_conn_manager_prefix) (rate(envoy_http_downstream_rq_total{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_http_conn_manager_prefix!~\"admin|eg-.*\"}[$__rate_interval]))",
                        "legendFormat": "{{cluster}} {{envoy_http_conn_manager_prefix}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "upstream-5xx-rate": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Upstream 5xx Rate",
          "description": "5xx responses per second from HTTPRoute upstreams.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(rate(envoy_cluster_upstream_rq_xx{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\",envoy_response_code_class=\"5\"}[$__rate_interval])) or vector(0)",
                        "legendFormat": "5xx"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "decimals": 3,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.001,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "upstream-latency-p99": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Upstream Latency p99",
          "description": "99th percentile upstream request time across all HTTPRoutes.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval])))",
                        "legendFormat": "p99"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "15m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "decimals": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 250,
                        "color": "yellow"
                      },
                      {
                        "value": 1000,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "upstream-latency-p99-by-httproute": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Upstream Latency p99 by HTTPRoute",
          "description": "99th percentile upstream request time per HTTPRoute. Routes here are sparse, so samples are drawn as points; a gap means no request was served in that window, not that the route was slow.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "histogram_quantile(0.99, sum by (cluster, route, le) (label_replace(sum by (cluster, envoy_cluster_name, le) (rate(envoy_cluster_upstream_rq_time_bucket{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\",envoy_cluster_name=~\"httproute/.*\"}[$__rate_interval])), \"route\", \"$1/$2\", \"envoy_cluster_name\", \"httproute/([^/]+)/([^/]+)/.*\")))",
                        "legendFormat": "{{cluster}} {{route}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "15m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "custom": {
                    "showPoints": "always",
                    "pointSize": 6
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "xds-connected-state": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "xDS Connected State",
          "description": "Per-proxy xDS connection to the envoy-gateway controller (1 = connected).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "min by (cluster, pod) (envoy_control_plane_connected_state{job=\"monitoring/envoy-gateway-proxy\",cluster=~\"$cluster\"})",
                        "legendFormat": "{{cluster}} {{pod}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
