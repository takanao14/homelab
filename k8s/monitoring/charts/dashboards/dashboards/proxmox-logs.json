              },
              "fieldConfig": {
                "defaults": {
                  "unit": "cps",
                  "min": 0,
                  "custom": {
                    "fillOpacity": 10,
                    "spanNulls": true
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
