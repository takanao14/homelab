{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "proxmox-logs"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "errors-1h": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Errors (1h)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({host=~\"$node\", appname=~\"$appname\", severity=~\"emerg|alert|crit|err|error|[0-3]\"}[1h])) or vector(0)",
                        "legendFormat": "errors",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "errors-by-node": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Errors by Node",
          "description": "Empty is good. A healthy day on these hosts produces a handful of error-severity lines at most, so a flat set of zero bars is the normal reading.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (host) (count_over_time({host=~\"$node\", appname=~\"$appname\", severity=~\"emerg|alert|crit|err|error|[0-3]\"}[$__auto])) or sum by (host) (count_over_time({host=~\"$node\", appname=~\"$appname\", severity=~\"$severity\"}[$__range])) * 0",
                        "legendFormat": "{{host}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "1m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {
                    "drawStyle": "bars",
                    "gradientMode": "hue",
                    "fillOpacity": 100,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "errors-by-service": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Errors by Service",
          "description": "Empty is good. Every service on the hosts is listed at zero so the panel still reads as healthy when nothing has erred; a service lifts a bar off the baseline only when it actually logs an error. In practice that is pveproxy and rsyslogd, a handful of lines a day.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum by (appname) (count_over_time({host=~\"$node\", appname=~\"$appname\", severity=~\"emerg|alert|crit|err|error|[0-3]\"}[$__auto])) or sum by (appname) (count_over_time({host=~\"$node\", appname=~\"$appname\", severity=~\"$severity\"}[$__range])) * 0",
                        "legendFormat": "{{appname}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "1m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {
                    "drawStyle": "bars",
                    "gradientMode": "hue",
                    "fillOpacity": 100,
                    "stacking": {
                      "mode": "normal"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "log-rate": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Log Rate",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(rate({host=~\"$node\", appname=~\"$appname\", severity=~\"$severity\"}[5m])) or vector(0)",
                        "legendFormat": "logs/s",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "cps",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "matching-operational-signals": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Matching Operational Signals",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "{host=~\"$node\", appname=~\"$appname\", severity=~\"$severity\"} | json | __error__=\"\" | line_format \"{{.message}}\" |~ `(?i)(quorum.*(lost|error|fail)|corosync.*(error|fail)|cluster.*(lost|error|fail))|(?i)(ha[- ]?(crm|lrm)?.*(error|fail))|(?i)((backup|vzdump).*(error|fail))|(?i)(zfs.*(error|fault|degrad)|i/o error)|(?i)(out of memory|oom-kill|killed process)|(?i)apparmor=\"DENIED\"` | line_format \"{{.host}} [{{.severity}}] {{.appname}}: {{.message}}\"",
                        "maxLines": 500
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "showLabels": false,
                "showCommonLabels": false,
                "showTime": true,
                "showLogContextToggle": true,
                "wrapLogMessage": false,
                "prettifyLogMessage": false,
                "enableLogDetails": true,
                "sortOrder": "Descending",
                "dedupStrategy": "",
                "showControls": true,
                "showFieldSelector": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "operational-signals-24h": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Operational Signals (24h)",
          "description": "Empty is good. Quorum, HA, backup, storage/ZFS, OOM, and AppArmor denial messages; a healthy cluster matches none of them, so any non-zero value here is worth reading the log panel for.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(count_over_time({host=~\"$node\", appname=~\"$appname\", severity=~\"$severity\"} | json | __error__=\"\" | line_format \"{{.message}}\" |~ `(?i)(quorum.*(lost|error|fail)|corosync.*(error|fail)|cluster.*(lost|error|fail))|(?i)(ha[- ]?(crm|lrm)?.*(error|fail))|(?i)((backup|vzdump).*(error|fail))|(?i)(zfs.*(error|fault|degrad)|i/o error)|(?i)(out of memory|oom-kill|killed process)|(?i)apparmor=\"DENIED\"` [24h])) or vector(0)",
                        "legendFormat": "signals",
                        "instant": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
