{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "openbao-overview"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "boltdb-store-logs-time": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "BoltDB Store Logs Time",
          "description": "Time to persist raft log entries to BoltDB — the usual disk-latency bottleneck. Reported only for intervals that had writes (see Request Latency).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_raft_boltdb_storeLogs{job=\"scrapeConfig/monitoring/openbao\",quantile=~\"0.5|0.9|0.99\"}",
                        "legendFormat": "p{{quantile}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "custom": {
                    "showPoints": "always",
                    "pointSize": 5,
                    "spanNulls": 900000
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "ha-mode": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "HA Mode",
          "description": "Whether this node is the active node (single-node raft: always Active when healthy).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_core_active{job=\"scrapeConfig/monitoring/openbao\"}",
                        "instant": true,
                        "legendFormat": "Active",
                        "range": false
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "none",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Standby",
                          "color": "yellow"
                        },
                        "1": {
                          "text": "Active",
                          "color": "green"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "leases": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Leases",
          "description": "Live leases in the expiration manager. Irrevocable leases indicate revocation failures.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_expire_num_leases{job=\"scrapeConfig/monitoring/openbao\"}",
                        "legendFormat": "leases"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_expire_num_irrevocable_leases{job=\"scrapeConfig/monitoring/openbao\"}",
                        "legendFormat": "irrevocable"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {}
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "irrevocable"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "raft-applies-per-collection-interval": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Raft Applies per Collection Interval",
          "description": "Raft log entries applied to the FSM, as counted by OpenBao over its own metrics interval. Not a per-second rate: the value is already a count, and it is republished rather than accumulated, so a step up means more writes in that interval and not a rising total.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(vault_raft_apply{job=\"scrapeConfig/monitoring/openbao\"}) or sum(up{job=\"scrapeConfig/monitoring/openbao\"}) * 0",
                        "legendFormat": "applies"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "raft-commit-time": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Raft Commit Time",
          "description": "Time to commit a raft log entry. Reported only for intervals that had writes, so the markers are the real readings (see Request Latency).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_raft_commitTime{job=\"scrapeConfig/monitoring/openbao\",quantile=~\"0.5|0.9|0.99\"}",
                        "legendFormat": "p{{quantile}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "custom": {
                    "showPoints": "always",
                    "pointSize": 5,
                    "spanNulls": 900000
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "request-latency": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Request Latency",
          "description": "Core request handling latency percentiles. The summary reports NaN for an interval with no requests, so the markers are the real readings and the line only joins them across gaps shorter than 15 minutes.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_core_handle_request{job=\"scrapeConfig/monitoring/openbao\",quantile=~\"0.5|0.9|0.99\"}",
                        "legendFormat": "p{{quantile}}"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "custom": {
                    "showPoints": "always",
                    "pointSize": 5,
                    "spanNulls": 900000
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "requests-per-collection-interval": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Requests per Collection Interval",
          "description": "Core requests and login requests, as counted by OpenBao over its own metrics interval (prometheus_retention_time, 60s). Not a per-second rate: the value is already a count and is republished rather than accumulated, so a step up means more requests in that interval.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(vault_core_handle_request_count{job=\"scrapeConfig/monitoring/openbao\"}) or sum(up{job=\"scrapeConfig/monitoring/openbao\"}) * 0",
                        "legendFormat": "requests"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(vault_core_handle_login_request_count{job=\"scrapeConfig/monitoring/openbao\"}) or sum(up{job=\"scrapeConfig/monitoring/openbao\"}) * 0",
                        "legendFormat": "logins"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "scrape-target": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Scrape Target",
          "description": "Whether Prometheus can reach the OpenBao metrics endpoint.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "up{job=\"scrapeConfig/monitoring/openbao\"}",
                        "instant": true,
                        "legendFormat": "Up",
                        "range": false
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "none",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "DOWN",
                          "color": "red"
                        },
                        "1": {
                          "text": "UP",
                          "color": "green"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "seal-status": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Seal Status",
          "description": "OpenBao seal status. Sealed means all secret operations fail until unsealed (static seal auto-unseals on restart).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "vault_core_unsealed{job=\"scrapeConfig/monitoring/openbao\"}",
                        "instant": true,
                        "legendFormat": "Seal",
                        "range": false
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "none",
                "colorMode": "background",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Sealed",
                          "color": "red"
                        },
                        "1": {
                          "text": "Unsealed",
                          "color": "green"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "service-tokens": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Service Tokens",
          "description": "Live service tokens in the token store. OpenBao recomputes this every ten minutes rather than on each scrape, so the reading here can be up to that old.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(last_over_time(vault_token_count{job=\"scrapeConfig/monitoring/openbao\"}[15m]))",
                        "instant": true,
                        "legendFormat": "Tokens",
                        "range": false
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "value",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "blue"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "tokens-identity-entities": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Tokens \u0026 Identity Entities",
          "description": "Service token count and identity entities over time. Both are recomputed every ten minutes, not per scrape, so each step repeats the last collected value instead of drawing a line between two distant points. A runaway token count points at a login loop (e.g. an ESO auth misconfiguration).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(last_over_time(vault_token_count{job=\"scrapeConfig/monitoring/openbao\"}[15m]))",
                        "legendFormat": "tokens"
                      }
                    },
                    "refId": "query-0",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "last_over_time(vault_identity_num_entities{job=\"scrapeConfig/monitoring/openbao\"}[15m])",
                        "legendFormat": "entities"
                      }
                    },
                    "refId": "query-1",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Status",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 4,
                  "columnWidthMode": "narrow",
                  "rowHeightMode": "short",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "scrape-target"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "seal-status"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "ha-mode"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "service-tokens"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Requests",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "requests-per-collection-interval"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "request-latency"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Raft Storage",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "standard",
                  "rowHeightMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
