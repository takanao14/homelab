{
  "uid": "slack-bot-overview",
  "title": "slack-bot Overview",
  "tags": [
    "slack-bot",
    "slack",
    "led"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "5m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "max by (cluster) (slack_bot_socket_connected{job=\"slack-bot\",cluster=~\"$cluster\"})",
          "instant": true,
          "legendFormat": "{{cluster}}",
          "range": false
        }
      ],
      "title": "Slack Connection",
      "description": "Whether the Socket Mode connection is established. The pod stays Ready and /healthz keeps returning 200 while this is 0, so nothing else reports the outage. No data means the bot is not deployed to the selected cluster.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DISCONNECTED",
                  "color": "red"
                },
                "1": {
                  "text": "CONNECTED",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "time() - max by (cluster) (process_start_time_seconds{job=\"slack-bot\",cluster=~\"$cluster\"})",
          "instant": true,
          "legendFormat": "{{cluster}}",
          "range": false
        }
      ],
      "title": "Uptime",
      "description": "Time since the process started. A reset that nobody deployed points at a liveness probe failure or an OOM kill.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "ceil(sum(increase(slack_bot_led_send_total{job=\"slack-bot\",cluster=~\"$cluster\",result=\"error\"}[24h]))) or vector(0)",
          "legendFormat": "Failures"
        }
      ],
      "title": "LED Send Failures (24h)",
      "description": "Failed image sends in the last 24 hours. Check the led-rpi3 TCP probe first: if that is healthy the port is open and the failure is in the send itself.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "ceil(sum(increase(slack_bot_render_failures_total{job=\"slack-bot\",cluster=~\"$cluster\"}[24h]))) or vector(0)",
          "legendFormat": "Failures"
        }
      ],
      "title": "Render Failures (24h)",
      "description": "Messages that could not be rendered to an image in the last 24 hours, before any LED send was attempted. Font and emoji problems land here.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Message Delivery",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "round(sum by (cluster) (increase(slack_bot_messages_rendered_total{job=\"slack-bot\",cluster=~\"$cluster\"}[$__interval])))",
          "legendFormat": "{{cluster}} rendered"
        },
        {
          "expr": "round(sum by (cluster) (increase(slack_bot_led_send_total{job=\"slack-bot\",cluster=~\"$cluster\",result=\"ok\"}[$__interval])))",
          "legendFormat": "{{cluster}} delivered"
        },
        {
          "expr": "round(sum by (cluster) (increase(slack_bot_led_send_total{job=\"slack-bot\",cluster=~\"$cluster\",result=\"error\"}[$__interval])))",
          "legendFormat": "{{cluster}} failed"
        }
      ],
      "title": "Rendering \u0026 Delivery",
      "description": "Messages rendered and images delivered per interval. Rendered without a matching delivery means the LED path dropped the image; the two lines otherwise track each other.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "repeatDirection": "h",
      "interval": "1h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "gradientMode": "hue",
            "fillOpacity": 100
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (cluster, le) (rate(slack_bot_led_send_duration_seconds_bucket{job=\"slack-bot\",cluster=~\"$cluster\"}[$__rate_interval])))",
          "legendFormat": "{{cluster}} p95"
        },
        {
          "expr": "sum by (cluster) (rate(slack_bot_led_send_duration_seconds_sum{job=\"slack-bot\",cluster=~\"$cluster\"}[$__rate_interval])) / sum by (cluster) (rate(slack_bot_led_send_duration_seconds_count{job=\"slack-bot\",cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "{{cluster}} mean"
        }
      ],
      "title": "LED Send Latency",
      "description": "Time spent in an image send. Sends are rare, so samples are drawn as points and a gap means no message was sent, not a failure. The histogram buckets reach 640ms while observed sends complete in single-digit milliseconds; keep the range until a slow device proves which resolution matters.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "repeatDirection": "h",
      "interval": "1h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Process",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (cluster) (go_memstats_heap_inuse_bytes{job=\"slack-bot\",cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} heap in use"
        },
        {
          "expr": "max by (cluster) (process_resident_memory_bytes{job=\"slack-bot\",cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}} resident"
        }
      ],
      "title": "Memory",
      "description": "Heap in use against the process resident set. The emoji list and image caches hold entries for 24 hours, so a sawtooth is expected and a monotonic climb is not.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (cluster) (go_goroutines{job=\"slack-bot\",cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}"
        }
      ],
      "title": "Goroutines",
      "description": "Live goroutines. Each Slack event is handled on the event loop, so a count that grows with traffic and never returns marks a leaked handler.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Datasource",
        "skipUrlSync": false,
        "query": "prometheus",
        "multi": false,
        "allowCustomValue": true,
        "includeAll": false,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "cluster",
        "label": "Cluster",
        "skipUrlSync": false,
        "query": "label_values(kube_node_info, cluster)",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {}
}