          "expr": "sort_desc((1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}) * on(instance) group_left(nodename) max by (instance, nodename) (node_uname_info) * 100)",
          "instant": true,
          "legendFormat": "{{nodename}}",
          "range": false
        }
      ],
      "title": "Memory Usage",
      "transparent": false,
      "datasource": {
