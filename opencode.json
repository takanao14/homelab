{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lemonade": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://lemonade.prd.butaco.net/v1"
      },
      "models": {
        "Gemma-4-12B-it-MTP-GGUF": {
          "name": "Gemma 4 12B MTP (Lemonade)"
        }
      }
    }
  },
  "model": "lemonade/Gemma-4-12B-it-MTP-GGUF",
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "./scripts/grafana-mcp.sh"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  },
  "tools": {
    "grafana_*": false
  },
  "agent": {
    "grafana": {
      "description": "Read-only Grafana observability queries",
      "mode": "subagent",
      "tools": {
        "grafana_*": true
      },
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
