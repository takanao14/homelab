controller:
  enableSnapshotter: false

# k0s keeps kubelet state below /var/lib/k0s, not the upstream default
# /var/lib/kubelet. Both the controller and node plugin mount this host path.
kubeletDir: /var/lib/k0s/kubelet

storageClass:
  create: true
  name: nfs
  annotations:
    storageclass.kubernetes.io/is-default-class: {{ eq (env "K0S_DEFAULT_STORAGE_CLASS") "nfs" | quote }}
  parameters:
    server: {{ requiredEnv "K0S_NFS_SERVER" | quote }}
    share: {{ requiredEnv "K0S_NFS_SHARE" | quote }}
    subDir: ${pvc.metadata.namespace}/${pvc.metadata.name}-${pv.metadata.name}
    # Pods use different UIDs/GIDs and NFS root squashing can prevent kubelet
    # from changing ownership. PVC subdirectories are isolated by Kubernetes
    # mounts; make each one writable without relying on server-side UID parity.
    mountPermissions: "0777"
    onDelete: retain
  reclaimPolicy: Retain
  volumeBindingMode: Immediate
  mountOptions:
    - nfsvers=4.1
    - hard
