controller:
  enableSnapshotter: false

# k0s kubelet path mounted by controller and node plugins.
kubeletDir: /var/lib/k0s/kubelet

storageClass:
  create: true
  name: nfs
  annotations:
    storageclass.kubernetes.io/is-default-class: {{ eq (env "K0S_DEFAULT_STORAGE_CLASS") "nfs" | quote }}
  parameters:
    server: {{ requiredEnv "K0S_NFS_SERVER" | quote }}
    share: {{ requiredEnv "K0S_NFS_SHARE" | quote }}
    subDir: ${pvc.metadata.namespace}/${pvc.metadata.name}-${pv.metadata.name}
    # Support varied pod IDs despite root squash; mounts isolate PVC subdirectories.
    mountPermissions: "0777"
    onDelete: retain
  reclaimPolicy: Retain
  volumeBindingMode: Immediate
  mountOptions:
    - nfsvers=4.1
    - hard
