kubeProxyReplacement: true
k8sServiceHost: {{ requiredEnv "K0S_CONTROLLER_ADDRESSES" | splitList "," | first | trim }}
k8sServicePort: 6443
l2announcements:
  enabled: true
externalIPs:
  enabled: true
# Envoy Gateway owns ingress (ADR-0011); Cilium owns CNI, LB IPAM and L2.
# metricsService is bootstrap-safe before monitoring CRDs; ServiceMonitors live there.
prometheus:
  enabled: true
  metricsService: true
operator:
  replicas: 1
  prometheus:
    enabled: true
    metricsService: true
hubble:
  # Double flow history; restart agents after this startup setting changes.
  eventBufferCapacity: 8191
  # Expose L3/L4 metrics only; L7 requires Envoy redirection.
  metrics:
    enabled:
      - dns
      - drop
      - tcp
      - flow
      - icmp
      - port-distribution
